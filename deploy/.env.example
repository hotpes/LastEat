# 복사해서 deploy/.env로 만들고 값을 채운다. .env는 git에 올리지 않는다
#   cp .env.example .env && chmod 600 .env

# HTTPS 인증서를 받을 도메인. 로컬 확인은 localhost
DOMAIN=lasteat.duckdns.org

# MySQL 비밀번호. 처음 띄울 때 정한 값이 DB에 저장된다. 나중에 바꾸면 DB 쪽 비밀번호도 같이 바꿔야 한다
# 예: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# accessToken 서명 키. 32바이트 이상. 바꾸면 모두 다시 로그인해야 한다
# 예: openssl rand -base64 48
JWT_SECRET=

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 ID (숫자). 앱이 카카오 SDK에 등록한 앱과 같아야 한다
KAKAO_APP_ID=

# 앱 이미지 태그. 비우면 latest. 문제가 생기면 이전 커밋 태그(sha-xxxxxxx)로 되돌린다
APP_TAG=
